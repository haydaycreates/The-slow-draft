---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Not found" description="That page does not exist.">
  <section class="section">
    <div class="wrap notfound">
      <p class="eyebrow">404</p>
      <h1>This page went for a walk.</h1>
      <p class="muted">The link may be old, or the post may have been renamed.</p>
      <p class="hero-actions">
        <a class="btn btn-solid" href="/">Back home</a>
        <a class="btn btn-ghost" href="/blog/">Browse the blog</a>
      </p>
    </div>
  </section>
</BaseLayout>
