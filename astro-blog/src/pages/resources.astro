---
import { getCollection, getEntry, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../site.config.js';
import { ICONS } from '../lib/format.js';

const page = await getEntry('pages', 'resources');
const { Content } = await render(page);

const all = (await getCollection('resources'))
  .sort((a, b) => a.data.order - b.data.order || a.data.title.localeCompare(b.data.title));

/* grouped in the order the categories first appear — same as the dynamic site */
const groups = [];
for (const resource of all) {
  const category = resource.data.category || 'General';
  let group = groups.find((g) => g.category === category);
  if (!group) { group = { category, items: [] }; groups.push(group); }
  group.items.push(resource);
}
---

<BaseLayout
  title="Resources"
  description={page.data.heading || 'Tools, newsletters and reading I recommend.'}
  active="/resources/"
>
  <section class="page-head">
    <div class="wrap">
      <p class="eyebrow">{page.data.eyebrow || 'Resources'}</p>
      <h1>{page.data.heading}</h1>
      <div class="prose page-intro"><Content /></div>
    </div>
  </section>

  {groups.length > 0
    ? groups.map((group, index) => (
        <section class={`section ${index % 2 === 1 ? 'section-alt' : ''} section-tight`}>
          <div class="wrap">
            <div class="section-head">
              <h2>{group.category}</h2>
              <span class="muted small">{group.items.length} item{group.items.length === 1 ? '' : 's'}</span>
            </div>
            <div class="grid grid-3">
              {group.items.map((resource) => (
                <a class="res-card" href={resource.data.url} target="_blank" rel="noopener">
                  <span class="res-cat">{resource.data.category}</span>
                  <h3>{resource.data.title}</h3>
                  <p>{resource.data.description}</p>
                  <span class="res-url">
                    {resource.data.url.replace(/^https?:\/\//, '').replace(/\/$/, '')}
                    <Fragment set:html={ICONS.globe} />
                  </span>
                </a>
              ))}
            </div>
          </div>
        </section>
      ))
    : (
      <section class="section">
        <div class="wrap">
          <div class="empty">
            <h3>No resources yet</h3>
            <p>Add a markdown file to src/content/resources/ and it will appear here.</p>
          </div>
        </div>
      </section>
    )}
</BaseLayout>
