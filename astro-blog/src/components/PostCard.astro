---
import { fmtDate, isoDate, readingTime, excerptOf, postUrl } from '../lib/format.js';

const { post, featured = false } = Astro.props;
const tags = (post.data.tags || []).slice(0, 3);
const date = post.data.date;
---

<article class={`card${featured ? ' card-featured' : ''}`} data-post-card>
  <a class="card-hit" href={postUrl(post.id)} aria-label={post.data.title}></a>
  <div class="card-body">
    <p class="card-meta">
      <time datetime={isoDate(date)}>{fmtDate(date)}</time>
      <span class="dot">·</span><span>{readingTime(post.body)} min read</span>
      {post.data.draft && <span class="chip chip-draft">Draft</span>}
    </p>
    <h3 class="card-title">{post.data.title}</h3>
    <p class="card-excerpt">{excerptOf(post, featured ? 240 : 165)}</p>
    {tags.length > 0 && (
      <p class="card-tags">
        {tags.map((tag) => <span class="tag">{tag}</span>)}
      </p>
    )}
  </div>
</article>
